{
  "name": "gophp/task-api",
  "description": "Fixed-dependency Laravel task API for Go PHP compatibility validation",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-ctype": "*",
    "ext-filter": "*",
    "ext-hash": "*",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-session": "*",
    "ext-tokenizer": "*",
    "api-platform/laravel": "5.0.1",
    "laravel/framework": "12.69.3",
    "symfony/type-info": "^7.4",
    "symfony/web-link": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": false
    }
  }
}
